# Пример набора переменных для стенда.
# Скопируйте файл в .env и подставьте свои значения. Файл .env в репозиторий не попадает.

APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Начальные учетные записи. Пароли задаются только локально.
SEED_USER_LOGIN=
SEED_USER_DISPLAY_NAME=
SEED_USER_PASSWORD=
SEED_SPECIALIST_LOGIN=
SEED_SPECIALIST_DISPLAY_NAME=
SEED_SPECIALIST_PASSWORD=
